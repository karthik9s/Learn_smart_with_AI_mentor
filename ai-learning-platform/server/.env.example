# ── Server environment variables ───────────────────────────
# Copy to .env for local dev.
# In Render/Railway: add each as an environment variable.

GROQ_API_KEY=your-groq-api-key
PORT=5000

# Cohere — for semantic embedding cache
COHERE_API_KEY=your-cohere-api-key

# AI Providers (optional — missing keys are skipped in fallback chain)
# Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
# Mistral: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your-mistral-api-key

# Supabase — use the SERVICE ROLE key (not anon key)
# Dashboard → Project Settings → API → service_role
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Razorpay — Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Frontend URL for CORS
FRONTEND_URL=https://your-app.vercel.app
